# Banco
DATABASE_URL="postgresql://idpro:idpro@localhost:5432/idpro?schema=public"

# Sessão (troque em produção: openssl rand -base64 32)
AUTH_SECRET="dev-secret-troque-em-producao"

# OpenAI — sem esta chave a geração fica desligada e o app avisa na tela.
OPENAI_API_KEY=""
# Modelo usado na geração de ideias e prompts. Precisa aceitar imagens e
# resposta em JSON. Troque aqui se quiser outro.
OPENAI_MODEL="gpt-4o"

# Administrador criado/atualizado no boot do container.
ADMIN_EMAIL="admin@idpro.app"
ADMIN_PASSWORD="idpro"
ADMIN_NAME="Administrador"
